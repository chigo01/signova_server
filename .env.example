# Server Configuration
NODE_ENV=development
PORT=3001

# Database
MONGO_URI=mongodb://localhost:27017/signova

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production

# Google OAuth audiences accepted by the authentication server. REQUIRED for
# "Sign in with Google". Put the web/server OAuth client first; native apps ask
# Google to mint their ID token for that audience. More than one accepted
# client can be supplied as a comma-separated list during a migration.
GOOGLE_CLIENT_IDS=your_web_oauth_client_id.apps.googleusercontent.com
# Legacy single-value name, still accepted for existing deployments:
# GOOGLE_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com

# Sign in with Apple (native iOS)
APPLE_TEAM_ID=your_10_character_team_id
APPLE_KEY_ID=your_sign_in_with_apple_key_id
# Base64 of the complete .p8 file. Never commit the raw key or this value.
APPLE_PRIVATE_KEY_BASE64=base64_encoded_p8
APPLE_IOS_CLIENT_ID=com.signova.signova
# Generate with: openssl rand -base64 32
APPLE_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Optional future web flow:
# APPLE_SERVICE_CLIENT_ID=com.signova.signova.service
# APPLE_REDIRECT_URI=https://your-api.example.com/auth/apple/callback

# Frontend
FRONTEND_URL=http://localhost:3000

# Admin Server
ADMIN_SERVER_URL=http://localhost:8000

# Affiliate admin webapp — comma-separated emails allowed to access /admin/* endpoints.
# These users log in with the normal email-OTP flow; access is gated by this allowlist.
ADMIN_EMAILS=admin@signova.app

# Shared secret admin-server passes as `x-alert-secret` on POST /signals/alert.
# Must match the SIGNALS_ALERT_SECRET set in admin-server's env.
SIGNALS_ALERT_SECRET=your_signals_alert_secret_here

# Shared secret sent as `x-service-secret` when this server reads approved/elite
# signals from admin-server. Must match SIGNALS_READ_SECRET in admin-server's
# env, or cross-service signal reads will 401 (audit C1).
SIGNALS_READ_SECRET=your_signals_read_secret_here

# Webinar registration service, fixed Meet link, and raffle administrator.
# WEBINAR_SERVICE_SECRET must match the secret configured on the webinar Worker.
WEBINAR_SERVICE_SECRET=replace_with_a_long_random_secret
WEBINAR_MEET_URL=https://meet.google.com/replace-me
WEBINAR_NOTIFY_EMAIL=team@signova.app
WEBINAR_FROM_EMAIL=SIGNOVA Webinar <webinar@signova.app>
RAFFLE_ADMIN_PASSWORD=replace_with_a_strong_password
RAFFLE_ADMIN_SESSION_SECRET=replace_with_a_different_long_random_secret

# Test OTP bypass (optional — bypasses email proof for TEST_OTP_EMAIL; do not use on public production)
# Active when TEST_OTP_CODE is set (exactly 6 digits) and NODE_ENV is not production, OR set ENABLE_TEST_OTP for staging (true / 1 / yes, any case).
TEST_OTP_EMAIL=signovatest@signova.app
TEST_OTP_CODE=123456
ENABLE_TEST_OTP=false

# External APIs (Optional)
RESEND_API_KEY=your_resend_api_key
FCSAPI_KEY=your_fcsapi_key

# Stocks Feature APIs (Optional — get free keys instantly)
FINNHUB_API_KEY=your_finnhub_api_key         # https://finnhub.io/register
ALPHAVANTAGE_API_KEY=your_alphavantage_key   # https://www.alphavantage.co/support/#api-key
OPENAI_API_KEY=your_openai_api_key           # https://platform.openai.com/api-keys

# Personal watchlist news alerts. Keep disabled until Finnhub, OpenAI, and
# Resend are verified in the deployment environment.
STOCK_NEWS_ALERTS_ENABLED=false
STOCK_NEWS_ALERTS_CRON=*/15 * * * *

# Firebase Cloud Messaging
# Keep disabled until GOOGLE_APPLICATION_CREDENTIALS points to a service-account
# JSON file mounted by the deployment platform's secret manager.
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=signova-f7c94
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/signova-firebase-admin.json

# Anthropic Claude (for AI journal columns: summary, key-info, custom autofill, translation)
ANTHROPIC_API_KEY=your_anthropic_api_key     # https://console.anthropic.com/

# Bachs crypto checkout (optional, secondary to Dextopus).
# Sandbox: sk_sandbox_… → https://sandbox-api.bachs.io
# Live:    sk_live_…    → https://api.bachs.io
# Create a key with payments:read + payments:write, then register
# POST {API_HOST}/payments/webhook/bachs for collection.succeeded / failed /
# underpaid and checkout.expired.
BACHS_API_KEY=
# BACHS_BASE_URL=
BACHS_WEBHOOK_SECRET=
# Must be https. Bachs rejects localhost. If unset, the first public origin in
# FRONTEND_URLS is used (e.g. https://web.signova.app/dashboard/settings/pricing).
# BACHS_CALLBACK_URL=https://web.signova.app/dashboard/settings/pricing

# RevenueCat mobile subscriptions. Test Store keys are development-only.
REVENUECAT_API_KEY=test_your_test_store_key
REVENUECAT_ENTITLEMENT_ID=signova_app_pro
# Set this exact value as the webhook Authorization header in RevenueCat.
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace_with_a_long_random_secret
# Optional but recommended: enable HMAC signing in RevenueCat and copy its secret.
REVENUECAT_WEBHOOK_SIGNING_SECRET=

# Account deletion (Google Play / App Store 5.1.1(v) compliance).
# Members can schedule deletion in-app; the account stays fully usable for the
# grace window and can be revoked at any point before the purge runs.
ACCOUNT_DELETION_GRACE_DAYS=30
ACCOUNT_DELETION_PURGE_CRON=20 3 * * *
# Defaults to true when unset. Setting this to false pauses the irreversible
# purge only — requests and revocations keep working. Do not leave it off:
# scheduling deletions we never carry out breaks store compliance.
ACCOUNT_DELETION_PURGE_ENABLED=true
