# Server Configuration
NODE_ENV=development
PORT=3001

# Database
MONGO_URI=mongodb://localhost:27017/signova

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production

# Frontend
FRONTEND_URL=http://localhost:3000

# Admin Server
ADMIN_SERVER_URL=http://localhost:8000

# Test OTP bypass (optional — bypasses email proof for TEST_OTP_EMAIL; do not use on public production)
# Active when TEST_OTP_CODE is set (exactly 6 digits) and NODE_ENV is not production, OR set ENABLE_TEST_OTP for staging (true / 1 / yes, any case).
TEST_OTP_EMAIL=signovatest@signova.app
TEST_OTP_CODE=123456
ENABLE_TEST_OTP=false

# External APIs (Optional)
RESEND_API_KEY=your_resend_api_key
FCSAPI_KEY=your_fcsapi_key

# Stocks Feature APIs (Optional — get free keys instantly)
FINNHUB_API_KEY=your_finnhub_api_key         # https://finnhub.io/register
ALPHAVANTAGE_API_KEY=your_alphavantage_key   # https://www.alphavantage.co/support/#api-key
OPENAI_API_KEY=your_openai_api_key           # https://platform.openai.com/api-keys

# Paystack (required) — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# Optional override; defaults to ${FRONTEND_URL}/dashboard/settings/pricing
PAYSTACK_CALLBACK_URL=
